<!DOCTYPE html>
<html lang="id">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>Agen Apet Pandeglang | Supplier Kebutuhan Masyarakat & Dapur MBG</title>
  <meta name="description" content="Agen Apet Pandeglang melayani supplier kebutuhan masyarakat dan dapur MBG se-Kabupaten Pandeglang dengan layanan cepat, terpercaya, dan responsif." />
  <meta name="owner" content="Agus Suryana" />
  <meta name="admin" content="Deska Wiyata Praja S" />
  <meta name="theme-color" content="#18392b" />
  <meta property="og:title" content="Agen Apet Pandeglang" />
  <meta property="og:description" content="Supplier kebutuhan masyarakat dan dapur MBG se-Kabupaten Pandeglang." />
  <meta property="og:type" content="website" />
  <meta property="og:locale" content="id_ID" />
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link href="https://fonts.googleapis.com/css2?family=Manrope:wght@400;500;600;700;800&family=DM+Serif+Display:ital@0;1&display=swap" rel="stylesheet" />
  <style>
    :root {
      --bg: #f3efe4;
      --paper: rgba(255, 252, 245, 0.82);
      --surface: #fffaf0;
      --ink: #14211a;
      --muted: #59665d;
      --line: rgba(20, 33, 26, 0.12);
      --brand: #1e5a3c;
      --brand-2: #bb7a2f;
      --accent: #2f8f5b;
      --shadow: 0 20px 60px rgba(37, 45, 39, 0.12);
      --radius: 24px;
      --radius-sm: 16px;
      --container: 1180px;
    }

    * {
      box-sizing: border-box;
    }

    html {
      scroll-behavior: smooth;
    }

    body {
      margin: 0;
      font-family: "Manrope", sans-serif;
      color: var(--ink);
      background:
        radial-gradient(circle at top left, rgba(187, 122, 47, 0.15), transparent 28%),
        radial-gradient(circle at right 20%, rgba(47, 143, 91, 0.16), transparent 22%),
        linear-gradient(180deg, #f7f2e8 0%, #f1ecdf 100%);
      overflow-x: hidden;
    }

    body::before {
      content: "";
      position: fixed;
      inset: 0;
      pointer-events: none;
      background-image:
        linear-gradient(rgba(20, 33, 26, 0.025) 1px, transparent 1px),
        linear-gradient(90deg, rgba(20, 33, 26, 0.025) 1px, transparent 1px);
      background-size: 26px 26px;
      mask-image: linear-gradient(to bottom, rgba(0,0,0,.18), transparent 35%);
      z-index: -1;
    }

    img, svg {
      display: block;
      max-width: 100%;
    }

    a {
      color: inherit;
      text-decoration: none;
    }

    button {
      font: inherit;
    }

    .container {
      width: min(var(--container), calc(100% - 32px));
      margin: 0 auto;
    }

    .reveal {
      opacity: 0;
      transform: translateY(24px);
      transition: opacity 0.7s ease, transform 0.7s ease;
    }

    .reveal.visible {
      opacity: 1;
      transform: translateY(0);
    }

    .stagger > * {
      opacity: 0;
      transform: translateY(18px);
      animation: rise 0.8s ease forwards;
    }

    .stagger > *:nth-child(1) { animation-delay: 0.08s; }
    .stagger > *:nth-child(2) { animation-delay: 0.16s; }
    .stagger > *:nth-child(3) { animation-delay: 0.24s; }
    .stagger > *:nth-child(4) { animation-delay: 0.32s; }
    .stagger > *:nth-child(5) { animation-delay: 0.40s; }

    @keyframes rise {
      to {
        opacity: 1;
        transform: translateY(0);
      }
    }

    .site-header {
      position: sticky;
      top: 0;
      z-index: 50;
      backdrop-filter: blur(16px);
      background: rgba(247, 242, 232, 0.7);
      border-bottom: 1px solid rgba(20, 33, 26, 0.08);
    }

    .nav {
      display: flex;
      align-items: center;
      justify-content: space-between;
      gap: 16px;
      min-height: 76px;
    }

    .brand {
      display: flex;
      align-items: center;
      gap: 14px;
      min-width: 0;
    }

    .brand-mark {
      width: 44px;
      height: 44px;
      border-radius: 14px;
      background:
        linear-gradient(145deg, rgba(255,255,255,0.9), rgba(255,255,255,0.35)),
        linear-gradient(145deg, var(--brand), #254532);
      box-shadow: inset 0 1px 0 rgba(255,255,255,0.4), 0 12px 24px rgba(30,90,60,0.18);
      display: grid;
      place-items: center;
      color: #fff;
      font-weight: 800;
      letter-spacing: 0.04em;
    }

    .brand-copy {
      min-width: 0;
    }

    .brand-title {
      margin: 0;
      font-size: 0.98rem;
      font-weight: 800;
      line-height: 1.1;
    }

    .brand-subtitle {
      margin: 2px 0 0;
      color: var(--muted);
      font-size: 0.78rem;
      white-space: nowrap;
      overflow: hidden;
      text-overflow: ellipsis;
    }

    .nav-links {
      display: flex;
      align-items: center;
      gap: 20px;
    }

    .nav-links a {
      font-size: 0.95rem;
      color: var(--muted);
      position: relative;
    }

    .nav-links a::after {
      content: "";
      position: absolute;
      left: 0;
      bottom: -6px;
      width: 100%;
      height: 2px;
      transform: scaleX(0);
      transform-origin: left;
      background: var(--brand);
      transition: transform 0.25s ease;
    }

    .nav-links a:hover::after,
    .nav-links a:focus-visible::after {
      transform: scaleX(1);
    }

    .nav-cta,
    .btn {
      display: inline-flex;
      align-items: center;
      justify-content: center;
      gap: 10px;
      border: none;
      border-radius: 999px;
      padding: 14px 22px;
      font-weight: 800;
      transition: transform 0.22s ease, box-shadow 0.22s ease, background 0.22s ease;
      cursor: pointer;
    }

    .nav-cta,
    .btn-primary {
      color: #fff;
      background: linear-gradient(135deg, var(--brand), var(--accent));
      box-shadow: 0 14px 30px rgba(30, 90, 60, 0.25);
    }

    .btn-secondary {
      color: var(--ink);
      background: rgba(255,255,255,0.52);
      border: 1px solid rgba(20,33,26,0.1);
      backdrop-filter: blur(8px);
    }

    .nav-cta:hover,
    .btn:hover {
      transform: translateY(-2px) scale(1.01);
      box-shadow: 0 18px 34px rgba(30, 90, 60, 0.28);
    }

    .nav-cta:active,
    .btn:active {
      transform: translateY(0) scale(0.99);
    }

    .menu-toggle {
      display: none;
      width: 46px;
      height: 46px;
      border-radius: 14px;
      border: 1px solid var(--line);
      background: rgba(255,255,255,0.6);
      backdrop-filter: blur(10px);
      align-items: center;
      justify-content: center;
      cursor: pointer;
    }

    .menu-toggle span,
    .menu-toggle span::before,
    .menu-toggle span::after {
      display: block;
      width: 18px;
      height: 2px;
      border-radius: 2px;
      background: var(--ink);
      position: relative;
      transition: 0.25s ease;
    }

    .menu-toggle span::before,
    .menu-toggle span::after {
      content: "";
      position: absolute;
      left: 0;
    }

    .menu-toggle span::before { top: -6px; }
    .menu-toggle span::after { top: 6px; }

    .hero {
      padding: 46px 0 28px;
    }

    .hero-grid {
      display: grid;
      grid-template-columns: 1.1fr 0.9fr;
      gap: 28px;
      align-items: stretch;
    }

    .hero-copy,
    .hero-visual {
      background: var(--paper);
      border: 1px solid rgba(255,255,255,0.55);
      backdrop-filter: blur(16px);
      border-radius: calc(var(--radius) + 8px);
      box-shadow: var(--shadow);
    }

    .hero-copy {
      padding: clamp(28px, 4vw, 54px);
      position: relative;
      overflow: hidden;
    }

    .hero-copy::after {
      content: "";
      position: absolute;
      right: -80px;
      top: -90px;
      width: 220px;
      height: 220px;
      border-radius: 50%;
      background: radial-gradient(circle, rgba(187,122,47,0.22) 0%, transparent 65%);
    }

    .eyebrow {
      display: inline-flex;
      align-items: center;
      gap: 10px;
      margin-bottom: 16px;
      padding: 8px 14px;
      border-radius: 999px;
      background: rgba(30, 90, 60, 0.08);
      color: var(--brand);
      font-size: 0.82rem;
      font-weight: 800;
      letter-spacing: 0.06em;
      text-transform: uppercase;
    }

    .hero h1 {
      margin: 0;
      font-family: "DM Serif Display", serif;
      font-size: clamp(2.8rem, 6vw, 5.7rem);
      line-height: 0.96;
      letter-spacing: -0.03em;
      max-width: 10ch;
    }

    .hero-lead {
      max-width: 62ch;
      color: var(--muted);
      font-size: clamp(1rem, 1.6vw, 1.15rem);
      margin: 18px 0 0;
    }

    .hero-actions {
      display: flex;
      flex-wrap: wrap;
      gap: 14px;
      margin-top: 28px;
    }

    .hero-metrics {
      display: grid;
      grid-template-columns: repeat(3, minmax(0, 1fr));
      gap: 14px;
      margin-top: 30px;
    }

    .metric {
      padding: 14px 14px 16px;
      border-radius: 18px;
      background: rgba(255,255,255,0.65);
      border: 1px solid rgba(20,33,26,0.08);
    }

    .metric strong {
      display: block;
      font-size: 1.35rem;
      color: var(--brand);
      margin-bottom: 4px;
    }

    .metric span {
      font-size: 0.86rem;
      color: var(--muted);
    }

    .hero-visual {
      min-height: 540px;
      padding: 20px;
      display: grid;
      grid-template-rows: 1.1fr auto;
      gap: 18px;
      overflow: hidden;
      position: relative;
      background:
        linear-gradient(160deg, rgba(255,255,255,0.72), rgba(255,248,236,0.88)),
        radial-gradient(circle at 18% 20%, rgba(47,143,91,0.18), transparent 25%),
        radial-gradient(circle at 85% 20%, rgba(187,122,47,0.18), transparent 25%);
    }

    .visual-stage {
      position: relative;
      border-radius: 28px;
      overflow: hidden;
      background:
        linear-gradient(160deg, #e8f0e7 0%, #f4ecde 100%);
      border: 1px solid rgba(20,33,26,0.08);
      min-height: 320px;
    }

    .terrain {
      position: absolute;
      inset: auto -5% -12% -5%;
      height: 45%;
      background:
        radial-gradient(circle at 15% 30%, rgba(38,108,70,0.9) 0 18%, transparent 19%),
        radial-gradient(circle at 30% 36%, rgba(60,131,90,0.9) 0 16%, transparent 17%),
        radial-gradient(circle at 52% 24%, rgba(38,108,70,0.88) 0 19%, transparent 20%),
        radial-gradient(circle at 72% 38%, rgba(60,131,90,0.88) 0 16%, transparent 17%),
        radial-gradient(circle at 90% 28%, rgba(38,108,70,0.92) 0 18%, transparent 19%),
        linear-gradient(180deg, rgba(62,133,88,0.2), rgba(39,99,67,0.9));
      filter: blur(2px);
    }

    .sun {
      position: absolute;
      top: 12%;
      right: 14%;
      width: 94px;
      height: 94px;
      border-radius: 50%;
      background: radial-gradient(circle at 35% 35%, #fff6cf, #d89b48 72%);
      box-shadow: 0 0 50px rgba(216, 155, 72, 0.3);
    }

    .warehouse {
      position: absolute;
      left: 10%;
      bottom: 18%;
      width: 46%;
      height: 31%;
      border-radius: 20px 20px 12px 12px;
      background: linear-gradient(180deg, #fff8ed, #e8dbc4);
      border: 1px solid rgba(20,33,26,0.08);
      box-shadow: 0 20px 40px rgba(20,33,26,0.12);
    }

    .warehouse::before {
      content: "";
      position: absolute;
      left: -4%;
      top: -22%;
      width: 108%;
      height: 30%;
      clip-path: polygon(0 100%, 50% 0, 100% 100%);
      background: linear-gradient(180deg, #385843, #274132);
      border-radius: 12px;
    }

    .warehouse::after {
      content: "";
      position: absolute;
      left: 10%;
      bottom: 0;
      width: 24%;
      height: 42%;
      border-radius: 10px 10px 0 0;
      background: linear-gradient(180deg, #2d3f35, #18211b);
    }

    .truck {
      position: absolute;
      right: 12%;
      bottom: 18%;
      width: 40%;
      height: 18%;
      filter: drop-shadow(0 12px 20px rgba(20,33,26,0.12));
    }

    .truck-body {
      position: absolute;
      left: 0;
      top: 12%;
      width: 66%;
      height: 58%;
      border-radius: 14px;
      background: linear-gradient(180deg, #fff7eb, #ead9ba);
      border: 1px solid rgba(20,33,26,0.08);
    }

    .truck-body::before {
      content: "MBG";
      position: absolute;
      inset: 0;
      display: grid;
      place-items: center;
      color: var(--brand);
      font-weight: 800;
      letter-spacing: 0.12em;
    }

    .truck-cabin {
      position: absolute;
      right: 8%;
      top: 20%;
      width: 28%;
      height: 50%;
      border-radius: 12px 18px 8px 8px;
      background: linear-gradient(180deg, #2f8f5b, #245d40);
    }

    .wheel,
    .wheel::after {
      position: absolute;
      bottom: -6%;
      width: 18%;
      aspect-ratio: 1;
      border-radius: 50%;
      background: radial-gradient(circle at 45% 45%, #6d7b73 0 22%, #1d2621 23% 58%, #0d120f 59% 100%);
    }

    .wheel {
      left: 12%;
    }

    .wheel::after {
      content: "";
      left: 235%;
      bottom: 0;
    }

    .glass-statbar {
      display: grid;
      grid-template-columns: 1fr 1fr;
      gap: 14px;
    }

    .glass-pill {
      padding: 18px;
      border-radius: 20px;
      border: 1px solid rgba(255,255,255,0.45);
      background: rgba(255,255,255,0.52);
      backdrop-filter: blur(14px);
      box-shadow: inset 0 1px 0 rgba(255,255,255,0.3);
    }

    .glass-pill strong {
      display: block;
      font-size: 1.05rem;
      margin-bottom: 6px;
    }

    .glass-pill span {
      color: var(--muted);
      font-size: 0.9rem;
    }

    .section {
      padding: 34px 0;
    }

    .section-head {
      display: grid;
      grid-template-columns: 0.9fr 1.1fr;
      gap: 28px;
      align-items: end;
      margin-bottom: 22px;
    }

    .section-kicker {
      color: var(--brand);
      text-transform: uppercase;
      letter-spacing: 0.12em;
      font-size: 0.78rem;
      font-weight: 800;
      margin-bottom: 12px;
      display: inline-block;
    }

    .section-title {
      margin: 0;
      font-family: "DM Serif Display", serif;
      font-size: clamp(2rem, 4vw, 3.5rem);
      line-height: 1;
      letter-spacing: -0.02em;
    }

    .section-desc {
      margin: 0;
      color: var(--muted);
      font-size: 1rem;
      max-width: 60ch;
    }

    .about-grid {
      display: grid;
      grid-template-columns: 1.08fr 0.92fr;
      gap: 22px;
    }

    .panel {
      border-radius: var(--radius);
      background: var(--paper);
      backdrop-filter: blur(14px);
      border: 1px solid rgba(255,255,255,0.5);
      box-shadow: var(--shadow);
      overflow: hidden;
    }

    .panel-content {
      padding: 28px;
    }

    .feature-list {
      display: grid;
      gap: 16px;
    }

    .feature-row {
      display: grid;
      grid-template-columns: auto 1fr;
      gap: 14px;
      align-items: start;
    }

    .feature-icon {
      width: 46px;
      height: 46px;
      border-radius: 14px;
      display: grid;
      place-items: center;
      background: linear-gradient(135deg, rgba(30,90,60,0.12), rgba(187,122,47,0.14));
      color: var(--brand);
      flex-shrink: 0;
    }

    .feature-row h3 {
      margin: 0 0 4px;
      font-size: 1rem;
    }

    .feature-row p {
      margin: 0;
      color: var(--muted);
      font-size: 0.95rem;
    }

    .quote-box {
      position: relative;
      min-height: 100%;
      background:
        linear-gradient(155deg, rgba(30,90,60,0.95), rgba(26,63,45,0.96)),
        linear-gradient(180deg, transparent, rgba(255,255,255,0.05));
      color: #f7f3e9;
    }

    .quote-box::before {
      content: "";
      position: absolute;
      inset: auto -15% -18% auto;
      width: 220px;
      height: 220px;
      background: radial-gradient(circle, rgba(255,255,255,0.18), transparent 65%);
      border-radius: 50%;
    }

    .quote-box blockquote {
      margin: 0;
      font-family: "DM Serif Display", serif;
      font-size: clamp(1.6rem, 2.4vw, 2.25rem);
      line-height: 1.15;
      max-width: 13ch;
    }

    .quote-meta {
      margin-top: 22px;
      color: rgba(247,243,233,0.8);
      font-size: 0.95rem;
    }

    .service-layout {
      display: grid;
      grid-template-columns: 1.1fr 0.9fr;
      gap: 22px;
      align-items: stretch;
    }

    .service-stream {
      display: grid;
      gap: 16px;
      padding: 20px;
    }

    .service-item {
      display: grid;
      grid-template-columns: auto 1fr auto;
      gap: 16px;
      align-items: center;
      padding: 18px 18px;
      border-radius: 20px;
      background: rgba(255,255,255,0.58);
      border: 1px solid rgba(20,33,26,0.08);
      transition: transform 0.22s ease, background 0.22s ease;
    }

    .service-item:hover {
      transform: translateX(4px);
      background: rgba(255,255,255,0.82);
    }

    .service-num {
      font-weight: 800;
      color: var(--brand);
      font-size: 0.95rem;
      min-width: 32px;
    }

    .service-item h3 {
      margin: 0 0 4px;
      font-size: 1.02rem;
    }

    .service-item p {
      margin: 0;
      color: var(--muted);
      font-size: 0.94rem;
    }

    .service-arrow {
      color: var(--brand);
      font-size: 1.2rem;
      font-weight: 800;
    }

    .supply-board {
      padding: 24px;
      display: grid;
      gap: 18px;
      position: relative;
      background:
        linear-gradient(160deg, rgba(255,255,255,0.85), rgba(248,240,223,0.78));
    }

    .board-title {
      margin: 0;
      font-size: 1rem;
      color: var(--muted);
    }

    .board-main {
      display: grid;
      gap: 12px;
    }

    .board-strip {
      padding: 16px 18px;
      border-radius: 18px;
      background: #fff;
      border: 1px solid rgba(20,33,26,0.08);
      display: flex;
      justify-content: space-between;
      align-items: center;
      gap: 12px;
    }

    .board-strip strong {
      font-size: 0.98rem;
    }

    .board-strip span {
      color: var(--muted);
      font-size: 0.88rem;
    }

    .adv-grid {
      display: grid;
      grid-template-columns: repeat(4, minmax(0, 1fr));
      gap: 16px;
    }

    .adv-box {
      padding: 22px 18px;
      border-radius: 22px;
      background: rgba(255,255,255,0.52);
      border: 1px solid rgba(20,33,26,0.08);
      box-shadow: var(--shadow);
      min-height: 190px;
      display: flex;
      flex-direction: column;
      justify-content: space-between;
      transition: transform .25s ease, box-shadow .25s ease;
    }

    .adv-box:hover {
      transform: translateY(-6px);
      box-shadow: 0 26px 50px rgba(37,45,39,.14);
    }

    .adv-box .label {
      font-size: 0.76rem;
      text-transform: uppercase;
      letter-spacing: 0.12em;
      color: var(--brand);
      font-weight: 800;
    }

    .adv-box h3 {
      margin: 18px 0 8px;
      font-size: 1.1rem;
    }

    .adv-box p {
      margin: 0;
      color: var(--muted);
      font-size: 0.94rem;
    }

    .testimonial-layout {
      display: grid;
      grid-template-columns: 1fr 1fr;
      gap: 18px;
    }

    .testimonial {
      padding: 24px;
      border-radius: 24px;
      background: rgba(255,255,255,0.58);
      border: 1px solid rgba(20,33,26,0.08);
      box-shadow: var(--shadow);
    }

    .stars {
      color: var(--brand-2);
      letter-spacing: 0.12em;
      font-size: 0.95rem;
      margin-bottom: 12px;
    }

    .testimonial p {
      margin: 0;
      color: var(--ink);
      font-size: 1rem;
    }

    .testimonial footer {
      margin-top: 16px;
      color: var(--muted);
      font-size: 0.92rem;
    }

    .gallery {
      display: grid;
      grid-template-columns: 1.1fr 0.9fr;
      gap: 16px;
      min-height: 420px;
    }

    .gallery-left,
    .gallery-right > div {
      border-radius: 26px;
      overflow: hidden;
      position: relative;
      border: 1px solid rgba(20,33,26,0.08);
      box-shadow: var(--shadow);
      min-height: 200px;
    }

    .gallery-left {
      background:
        linear-gradient(160deg, rgba(24,57,43,0.92), rgba(47,143,91,0.78)),
        linear-gradient(180deg, transparent, rgba(255,255,255,0.06));
    }

    .gallery-left::before {
      content: "";
      position: absolute;
      inset: 0;
      background:
        radial-gradient(circle at 22% 25%, rgba(255,255,255,0.14), transparent 18%),
        linear-gradient(transparent 72%, rgba(14,24,19,0.35) 0),
        linear-gradient(90deg, transparent 78%, rgba(255,255,255,0.05) 0);
    }

    .gallery-right {
      display: grid;
      gap: 16px;
    }

    .g-card-1 {
      background:
        linear-gradient(180deg, rgba(255,250,241,0.96), rgba(238,227,203,0.88));
    }

    .g-card-2 {
      background:
        linear-gradient(180deg, rgba(238,246,237,0.96), rgba(221,235,217,0.88));
    }

    .gallery-copy {
      position: absolute;
